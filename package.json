{
  "name": "mass-datagrid-port",
  "private": true,
  "scripts": {
    "bootstrap": "pnpm install && cd backend && bundle install && bin/rails db:prepare",
    "dev": "concurrently -k -n api,web -c blue,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "cd backend && bin/rails server -p 3001",
    "dev:web": "pnpm --filter frontend dev",
    "import": "cd backend && bin/rails pokeapi:import",
    "import:status": "cd backend && bin/rails pokeapi:status",
    "check": "pnpm format:check && pnpm lint && pnpm knip && pnpm typecheck && pnpm test",
    "lint": "pnpm lint:api && pnpm lint:web",
    "lint:api": "cd backend && bin/rubocop",
    "lint:web": "pnpm --filter frontend lint",
    "knip": "pnpm --filter frontend knip",
    "format": "prettier --write . && cd backend && bin/rubocop --autocorrect",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter frontend typecheck",
    "test": "pnpm test:api && pnpm test:web",
    "test:api": "cd backend && bin/rails test",
    "test:web": "pnpm --filter frontend test",
    "coverage": "cd backend && COVERAGE=1 bin/rails test && cd .. && pnpm --filter frontend test:coverage",
    "build": "pnpm --filter frontend build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10"
  },
  "packageManager": "pnpm@12.14.0",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  }
}
