{
  "name": "mass-datagrid-port",
  "private": true,
  "scripts": {
    "bootstrap": "pnpm install && cd backend && bundle install && bin/rails db:prepare",
    "dev": "concurrently -k -n api,web -c blue,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "cd backend && bin/rails server -p 3001",
    "dev:web": "pnpm --filter frontend dev",
    "import": "cd backend && bin/rails pokeapi:import",
    "import:status": "cd backend && bin/rails pokeapi:status",
    "test": "pnpm test:api && pnpm --filter frontend lint && pnpm --filter frontend typecheck",
    "test:api": "cd backend && bin/rails test",
    "build": "pnpm --filter frontend build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "packageManager": "pnpm@12.14.0"
}
