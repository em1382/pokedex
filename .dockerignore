# Keep the build context small and free of local state; the image builds its
# own dependencies and imports its own data.
.git
.claude
**/node_modules
**/coverage
**/.env*
!**/.env.example
frontend/.next
frontend/tsconfig.tsbuildinfo
frontend/next-env.d.ts
backend/.bundle
backend/vendor/bundle
backend/log/*
backend/tmp/*
backend/storage/*
backend/config/*.key
