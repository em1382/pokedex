# App-specific ignores live in frontend/.gitignore and backend/.gitignore.

# Dependencies
node_modules/
.pnpm-store/

# Logs
*.log

# Environment files (may contain secrets)
.env*
!.env.example

# OS / editor files
.DS_Store
Thumbs.db
.idea/
*.swp

# Personal Claude Code settings (shared settings in .claude/settings.json are fine to commit)
.claude/settings.local.json
